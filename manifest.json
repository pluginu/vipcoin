{
  "manifest_version": 3,
  "name": "VIP Coin",
  "version": "1.3.0",
  "description": "Spot VIP profiles and track your custom watch terms on any website.",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VIP Coin",
    "default_icon": {
      "16": "icons/vip-16.png",
      "32": "icons/vip-32.png",
      "48": "icons/vip-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vip_list.csv"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/vip-16.png",
    "32": "icons/vip-32.png",
    "48": "icons/vip-48.png",
    "128": "icons/vip-128.png"
  }
}
