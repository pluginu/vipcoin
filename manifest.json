{
  "manifest_version": 3,
  "name": "VIP Coin Highlighter",
  "version": "1.2.1",
  "description": "Highlight VIP profiles and custom watch words on any website.",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VIP Coin Highlighter"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vip_list.csv"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
